# Environment & credentials
.env
.env.*
!.env.example
*.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# MLflow experiment tracking data (regenerated at runtime)
mlruns/
mlflow.db
playground/mlruns/

# Chainlit runtime dirs (regenerated by `chainlit run`)
.chainlit/
.files/

# Outputs and logs
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
playground/logs/

# OS/editor cruft
.DS_Store
Thumbs.db
