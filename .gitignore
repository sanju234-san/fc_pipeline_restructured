# Environment & credentials
.env
.env.*
*.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# MLflow experiment tracking data (regenerated at runtime)
mlruns/
mlflow.db

# Chainlit runtime dirs (regenerated by `chainlit run`)
.chainlit/
.files/

# Outputs and logs
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
