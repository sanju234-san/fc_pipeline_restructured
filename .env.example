# Supervisor LLM provider configuration
SUPERVISOR_LLM_ENDPOINT=
SUPERVISOR_LLM_MODEL=
SUPERVISOR_LLM_API_KEY=

# Optional: Groq API key (alternate LLM provider)
GROQ_API_KEY=

# Playground: path to a real EEG dataset file for local testing
PLAYGROUND_REAL_DATA_PATH=

# NVIDIA NeMo Guardrails (input + output rails, config in ./guardrails).
# Rails reuse the SUPERVISOR_LLM_* endpoint above — no separate LLM config.
# Set to true to enable; when unset/false the rails are skipped entirely.
NEMO_GUARDRAILS_ENABLED=true

# Deterministic pre-filter: plainly in-scope EEG requests skip the LLM input rail.
# Set to false to send every message through the NeMo rail.
NEMO_INPUT_FASTPATH=true

# Optional research helper (ddgs + Deep Agents, see requirements-research.txt). Off by default.
FC_RESEARCH_ENABLED=false

# Input guardrail backend: "nemo" (default, NeMo self-check) or "dspy" (DSPy InputScopeClassifier,
# optimisable with scripts/optimize_input_scope.py). Needs requirements-research.txt for dspy.
INPUT_RAIL_BACKEND=nemo
# Optional: optimised DSPy program to load (default outputs/dspy/input_scope.json if present).
INPUT_RAIL_DSPY_PROGRAM=
