# Supervisor LLM provider configuration
SUPERVISOR_LLM_ENDPOINT=
SUPERVISOR_LLM_MODEL=
SUPERVISOR_LLM_API_KEY=

# Optional: Groq API key (alternate LLM provider)
GROQ_API_KEY=

# Playground: path to a real EEG dataset file for local testing
PLAYGROUND_REAL_DATA_PATH=

# NVIDIA NeMo Guardrails (input + output rails, config in ./guardrails).
# Rails reuse the SUPERVISOR_LLM_* endpoint above — no separate LLM config.
# Set to true to enable; when unset/false the rails are skipped entirely.
NEMO_GUARDRAILS_ENABLED=true
